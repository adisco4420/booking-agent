# --- Required
# Shared secret Chord sends as "Authorization: Bearer <token>". Generate: openssl rand -hex 32
MCP_BEARER_TOKEN=
# Public base URL of this server (no trailing slash). Used for the Paystack callback page.
PUBLIC_BASE_URL=https://salon-mcp.example.com

# --- Storage: sheets (default) | memory (local dev only, data lost on restart)
STORE=sheets
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Bookings
# Service account key JSON, base64-encoded on one line: base64 -w0 service-account.json
# Share the sheet with the service account's client_email as Editor.
GOOGLE_SERVICE_ACCOUNT_JSON_B64=

# --- Payments: paystack (default) | mock (local dev only)
PAYMENTS=paystack
# Test key only. The server refuses to start with sk_live_.
PAYSTACK_SECRET_KEY=sk_test_
# Paystack requires an email per transaction; WhatsApp customers rarely give one.
PLACEHOLDER_EMAIL_DOMAIN=example.com

# --- Business tuning
BUSINESS_NAME=Fade & Finesse Studio
DEPOSIT_NGN=2000
HOLD_MINUTES=15
CHAIRS=1
MAX_DAYS_AHEAD=60

# --- Ops
PORT=3000
RECON_LOG_PATH=/data/reconciliation.jsonl
# Demo only. ENABLE_CHAOS=true exposes POST /admin/chaos, which can make "mark booked" writes fail.
# Leave unset in a real deployment.
ENABLE_CHAOS=false
CHAOS_FAIL_CONFIRM_WRITES=false
